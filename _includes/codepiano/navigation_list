{% comment %} 动态读取所有 group:navigation 页面生成导航 {% endcomment %}
{% assign current_url_clean = page.url | remove:'/' | remove:'.html' %}
{% assign nav_pages = pages_list | sort: 'index' %}
{% for node in nav_pages %}
  {% if node.group == group %}
    {% assign node_url_clean = node.url | remove:'/' | remove:'.html' %}
    {% if node_url_clean == current_url_clean %}
      {% assign css_class = 'active' %}
    {% else %}
      {% assign css_class = '' %}
    {% endif %}
    <li class="{{ css_class }}"><a href="{{ node.url | remove:'.html' }}">{{ node.title }}</a></li>
  {% endif %}
{% endfor %}
