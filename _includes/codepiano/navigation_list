{% comment %} index.html页面中的导航 {% endcomment %}
{% assign current_nav_url = page.url %}
{% assign navigation_pages = site.pages | where: "group", "navigation" | sort: "index" %}
{% for nav_page in navigation_pages %}
  {% assign nav_url = nav_page.url %}
  {% if nav_url == current_nav_url %}
    <li class="active"><a href="{{ nav_page.url }}">{{ nav_page.title }}</a></li>
  {% else %}
    <li><a href="{{ nav_page.url }}">{{ nav_page.title }}</a></li>
  {% endif %}
{% endfor %}
