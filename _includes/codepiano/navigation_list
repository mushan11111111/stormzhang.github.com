{% comment %} 动态导航：遍历 site.pages 中 group: navigation 的页面 {% endcomment %}
{% assign nav_pages = site.pages | where: "group", "navigation" | sort: "index" %}
{% assign current_nav = page.url | remove:'/' | remove:'.html' %}

{% for nav_page in nav_pages %}
  {% assign nav_name = nav_page.url | remove:'/' | remove:'.html' %}
  {% assign nav_class = "" %}
  {% if nav_name == current_nav %}
    {% assign nav_class = "active" %}
  {% endif %}
  <li class="{{nav_class}}"><a href="{{ nav_page.url }}">{{ nav_page.title }}</a></li>
{% endfor %}
