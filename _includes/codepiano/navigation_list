{% assign nav_pages = site.pages | where: "group", "navigation" | sort: "navigation_order" %}
{% for p in nav_pages %}
  {% assign current_nav = page.url | remove: '/' | remove: '.html' %}
  {% assign p_nav = p.url | remove: '/' | remove: '.html' %}
  <li {% if p_nav == current_nav %}class="active"{% endif %}>
    <a href="{{ p.url | remove: '.html' }}">{{ p.title }}</a>
  </li>
{% endfor %}
